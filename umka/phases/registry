#!/usr/bin/env node
// The registry of `umka:run`: the frontmatter of the `*.md` files beside this script, read through `lib/phases.mjs`.
// `registry lint [--dir <phases>] [--skills <dir>]` checks every phase (keys, modes, the skill it names
// and its SKILL.md under `--skills`, `rounds`, both directions of every edge), every cycle (one
// phase on it must carry `rounds:`) and the `skills` list of the plugin manifest (every SKILL.md
// listed, every entry real), then exits 1 with one line per error.
// `registry graph [--dir <phases>]` prints it as a Mermaid flowchart.
// `registry paths [--dir <phases>]` prints the entry and terminal phases, every simple path from an
// entry to a terminal (checkpoints in [brackets], hitl in (parens)), their count, and every cycle.
// Node reads this file as a module of either kind, by the folder it is in, so it takes its
// modules from the process and its own module by dynamic import.
const fs = process.getBuiltinModule("node:fs");
const path = process.getBuiltinModule("node:path");
const here = path.dirname(fs.realpathSync(process.argv[1]));
const { MODES, KEYS, SKILL_NAME, load } = await import(path.join(here, "..", "lib", "phases.mjs"));

const target = (t) => (typeof t === "string" ? t : t.phase);
const edges = (phases) =>
  Object.fromEntries(Object.entries(phases).map(([s, p]) => [s, (Array.isArray(p.to) ? p.to : []).map(target).filter((t) => phases[t])]));
const show = (phases, slug) => (phases[slug].mode === "checkpoint" ? `[${slug}]` : phases[slug].mode === "hitl" ? `(${slug})` : slug);

// Every elementary cycle, each once, from its first node in file order.
function cycles(phases) {
  const next = edges(phases);
  const order = Object.keys(phases);
  const found = [];
  for (const [i, start] of order.entries()) {
    const walk = (node, trail) => {
      for (const t of next[node]) {
        if (t === start) found.push([...trail, start]);
        else if (order.indexOf(t) > i && !trail.includes(t)) walk(t, [...trail, t]);
      }
    };
    walk(start, [start]);
  }
  return found;
}

// Every simple path from a phase that `source` enters to a phase with no `to`.
function paths(phases) {
  const next = edges(phases);
  const entries = Object.keys(phases).filter((s) => (phases[s].from || []).includes("source"));
  const terminals = Object.keys(phases).filter((s) => next[s].length === 0);
  const found = [];
  const walk = (node, trail) => {
    if (next[node].length === 0) found.push(trail);
    for (const t of next[node]) if (!trail.includes(t)) walk(t, [...trail, t]);
  };
  for (const e of entries) walk(e, [e]);
  return { entries, terminals, paths: found };
}

// The SKILL.md of `name` under `skillsDir`, nested one level or under `vendor/`.
function skillFile(skillsDir, name) {
  return [path.join(skillsDir, name, "SKILL.md"), path.join(skillsDir, "vendor", name, "SKILL.md")].find((f) => fs.existsSync(f));
}

function lint(dir, skillsDir = path.join(dir, "..", "skills")) {
  const { phases, errors } = load(dir);
  if (Object.keys(phases).length === 0) errors.push(`${dir}: no phase files`);
  const has = (p, k) => p[k] !== undefined && p[k] !== "" && !(Array.isArray(p[k]) && k !== "to" && p[k].length === 0);
  for (const [slug, p] of Object.entries(phases)) {
    const err = (msg) => errors.push(`${p.file}: ${msg}`);
    if (p.phase !== slug) err(`phase: "${p.phase}" differs from the file name "${slug}"`);
    if (!MODES.includes(p.mode)) err(`mode: "${p.mode}" is not one of ${MODES.join(", ")}`);
    for (const k of ["skill", "artifact"]) if (!has(p, k)) err(`${k}: missing`);
    if (has(p, "skill") && !p.call) err(`skill: "${p.skill}" is not umka:<name>, human, or tool: <command>`);
    if (p.call?.kind === "human" && !["checkpoint", "hitl"].includes(p.mode)) err("skill: human only on a checkpoint or hitl phase");
    if (p.call?.kind === "skill") {
      const { name } = p.call;
      const file = skillFile(skillsDir, name);
      if (!SKILL_NAME.test(name)) err(`skill: "${name}" is not a skill name: 1-64 of a-z, 0-9 and -, with no leading, trailing or double hyphen`);
      else if (!file) err(`skill: "${name}" has no SKILL.md under ${skillsDir}`);
      else if (/^disable-model-invocation:\s*true\s*$/m.test((/^---\n([\s\S]*?)\n---/.exec(fs.readFileSync(file, "utf8")) || [])[1] || "")) err(`skill: "${name}" sets disable-model-invocation, so the model cannot call it`);
    }
    if (p.rounds !== undefined && !(Number.isInteger(p.rounds) && p.rounds > 0)) err(`rounds: "${p.rounds}" is not a positive integer`);
    if (!Array.isArray(p.from) || p.from.length === 0) err("from: missing");
    if (!Array.isArray(p.to)) err("to: missing");
    if (p.mode === "afk" && !has(p, "budget")) err("budget: missing on an afk phase");
    if (p.mode === "checkpoint" && !has(p, "ask")) err("ask: missing on a checkpoint");
    if (p.mode !== "checkpoint" && has(p, "auto-close when")) err("auto-close when: only a checkpoint has one");
    for (const k of Object.keys(p)) if (!["file", "body", "call"].includes(k) && !KEYS.includes(k)) err(`${k}: unknown key`);
    for (const t of Array.isArray(p.to) ? p.to : []) {
      const target = typeof t === "string" ? t : t.phase;
      if (!target) { err("to: an entry has no phase"); continue; }
      if (!phases[target]) { err(`to: target "${target}" has no phase file`); continue; }
      const back = Array.isArray(phases[target].from) ? phases[target].from : [];
      if (!back.includes(slug)) err(`to: target "${target}" does not list ${slug} in its from:`);
    }
    for (const f of Array.isArray(p.from) ? p.from : []) {
      if (f === "source") continue;
      if (!phases[f]) { err(`from: "${f}" has no phase file`); continue; }
      const fwd = (Array.isArray(phases[f].to) ? phases[f].to : []).map((t) => (typeof t === "string" ? t : t.phase));
      if (!fwd.includes(slug)) err(`from: "${f}" does not list ${slug} in its to:`);
    }
  }
  for (const c of cycles(phases)) {
    if (!c.some((s) => Number.isInteger(phases[s].rounds))) errors.push(`cycle without rounds: ${c.join(" > ")}`);
  }
  errors.push(...manifest(skillsDir));
  return errors;
}

// Claude Code loads a skill folder nested under `skills/` only when the plugin manifest lists it,
// so every SKILL.md under `skillsDir` must stand in the `skills` array of `.claude-plugin/plugin.json`
// beside it, and every entry there must have a SKILL.md. A skills dir with no manifest beside it
// (a test fixture) is not checked.
function manifest(skillsDir) {
  const root = path.resolve(skillsDir, "..");
  const file = path.join(root, ".claude-plugin", "plugin.json");
  if (!fs.existsSync(file)) return [];
  const listed = new Set((JSON.parse(fs.readFileSync(file, "utf8")).skills || []).map((s) => path.resolve(root, s)));
  const found = [];
  for (const level of [skillsDir, path.join(skillsDir, "vendor")]) {
    if (!fs.existsSync(level)) continue;
    for (const d of fs.readdirSync(level)) if (fs.existsSync(path.join(level, d, "SKILL.md"))) found.push(path.join(level, d));
  }
  const errors = [];
  for (const d of found) if (!listed.has(d)) errors.push(`${file}: skills does not list ${path.relative(root, d)}`);
  for (const d of listed) if (!found.includes(d)) errors.push(`${file}: skills lists ${path.relative(root, d)}, which has no SKILL.md`);
  return errors;
}

function pathsReport(dir) {
  const { phases } = load(dir);
  const r = paths(phases);
  const line = (xs) => xs.map((s) => show(phases, s)).join(" > ");
  return [
    `entries: ${r.entries.join(", ")}`,
    `terminals: ${r.terminals.join(", ")}`,
    ...r.paths.map(line),
    `${r.paths.length} paths`,
    "cycles:",
    ...cycles(phases).map(line),
  ].join("\n");
}

function graph(dir) {
  const { phases } = load(dir);
  const id = (s) => s.replace(/-/g, "_");
  const lines = ["flowchart TD", "  source([source])"];
  for (const [slug, p] of Object.entries(phases)) {
    const rounds = p.rounds !== undefined ? ` rounds ${p.rounds}` : "";
    const label = p.mode === "checkpoint" ? `{{"${slug}${rounds}"}}` : p.mode === "hitl" ? `[["${slug} (hitl)${rounds}"]]` : `["${slug} ${p.budget || ""}${rounds}"]`;
    lines.push(`  ${id(slug)}${label}`);
  }
  for (const [slug, p] of Object.entries(phases)) {
    if ((p.from || []).includes("source")) lines.push(`  source --> ${id(slug)}`);
    for (const t of p.to || []) {
      const when = typeof t === "string" ? "" : [t.when, t.per && `per ${t.per}`].filter(Boolean).join(", ");
      lines.push(`  ${id(slug)} -->${when ? `|"${when}"|` : ""} ${id(target(t))}`);
    }
  }
  return lines.join("\n");
}

const args = process.argv.slice(2);
const cmd = args[0];
const dirFlag = args.indexOf("--dir");
const dir = dirFlag >= 0 ? args[dirFlag + 1] : here;
const skillsFlag = args.indexOf("--skills");
if (cmd === "lint") {
  const errors = lint(dir, skillsFlag >= 0 ? args[skillsFlag + 1] : undefined);
  for (const e of errors) console.error(e);
  process.exit(errors.length ? 1 : 0);
} else if (cmd === "graph") {
  console.log(graph(dir));
} else if (cmd === "paths") {
  console.log(pathsReport(dir));
} else {
  console.error("usage: registry lint|graph|paths [--dir <phases>] [--skills <dir>]");
  process.exit(2);
}
